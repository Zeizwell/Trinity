; Шина слота (макет: CPLD MultiSound -> наш чип). Все ножки - из config.h (PIN_SLOT_*): номера в инструкциях ниже -
; заглушки, при загрузке (bus_add_program) ожидание строба патчится ножкой из config.h, базы и ножки переходов -
; в init. Требование к плате: D0..D7 слота подряд (PIN_SLOT_D0..+7), остальные ножки - любые в окне 32 ножек PIO.
; RP в разрыве: с чипа не читаем, на чтение отвечает RP - автомат bus_ans (bus_dma.pio, doc/zx-trinity.md п.14е).

; ---- Записи: на каждый /WR - в FIFO снимок 32 ножек от PIN_SLOT_D0 (данные, /CS, A0). Снимки DMA уносит в кольцо,
; разбирает ядро 1 без сроков (bus_hw.c).
; Данные - ПОСЛЕДНИЙ снимок, пока /WR ещё внизу (как NeoGS zxbus.v: защёлка по заднему фронту записи): на макете
; CPLD MultiSound выставляет данные одновременно с /AWR, раннее чтение ловило неустоявшиеся биты.
.program bus_wr
.wrap_target
    wait 0 gpio 0                    ; /WR вниз (ножка - PIN_SLOT_WR, патч при загрузке)
sample:
    in pins, 32                      ; снимок от PIN_SLOT_D0
    jmp pin done                     ; JMP_PIN = /WR: уже вверх - берём прошлый снимок
    mov x, isr                       ; снимок, после которого /WR ещё был внизу
    jmp sample
done:
    mov isr, x
    push noblock                     ; FIFO забирает DMA сразу (кольцо записей, bus_hw.c)
.wrap

; ---- Отладка (консоль, bus_hw.c журнал): на каждый /RD - длина импульса и последний снимок, пока /RD внизу.
; Слово: биты 31..20 - D0..D7, /CS, /WR, /RD, A0; 19..0 - ~счётчик (оборот 3 такта RP). Ложный /ARD CPLD MultiSound
; (защёлка clk32, top.v ioreq) - десятки нс, чтение Z80 - сотни
.program bus_rdw
.wrap_target
    wait 0 gpio 0                    ; /RD вниз (патч при загрузке)
    mov isr, null
    mov x, ~null
cnt:
    mov osr, pins                    ; снимок от PIN_SLOT_D0
    jmp pin up                       ; JMP_PIN = /RD: вверх - конец
    jmp x-- cnt
up:
    in osr, 12
    in x, 20
    push noblock
.wrap

% c-sdk {
// PIN_SLOT_* - из config.h (bus_hw.c подключает его до этого файла)

// Загрузить программу шины: ожидания строба (WAIT GPIO) - на ножку pin (заглушки в .pio - 0)
static inline uint bus_add_program(PIO pio, const pio_program_t *prog, uint pin) {
    static uint16_t ins[32];
    for (uint i = 0; i < prog->length; i++) {
        uint16_t x = prog->instructions[i];
        if ((x & 0xE060) == 0x2000)                  // WAIT, источник GPIO: индекс - ножка относительно базы PIO
            x = (uint16_t)((x & ~0x1F) | ((pin - pio_get_gpio_base(pio)) & 0x1F));
        ins[i] = x;
    }
    pio_program_t p = *prog;
    p.instructions = ins;
    return pio_add_program(pio, &p);
}

static inline void bus_wr_init(PIO pio, uint sm, uint offset) {
    pio_sm_config c = bus_wr_program_get_default_config(offset);
    sm_config_set_in_pins(&c, PIN_SLOT_D0);
    sm_config_set_jmp_pin(&c, PIN_SLOT_WR);          // /WR - конец записи
    sm_config_set_in_shift(&c, false, false, 32);   // влево: бит PIN_SLOT_D0 - младший
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);  // 8 записей в запасе
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
