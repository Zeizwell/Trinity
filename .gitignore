build/
*.uf2
*.elf
*.bin
*.map
*.dis

# чужие программы и материалы (ref/) - не в git, ссылки в README
ref/

# прошивки RP-AY по версиям храним (bin/rp_ay_vNN.uf2) - все остальные .uf2 нет
!firmware/rp-ay/bin/*.uf2

# KiCad: локальные истории, блокировки, резервные копии
KiCad/**/.history/
KiCad/**/~*.lck
KiCad/**/*-backups/
KiCad/**/.schgen-backup/

# генератор: проектные файлы его временного проекта
KiCad/trinity/gen/analog.kicad_pro
KiCad/trinity/gen/analog.kicad_prl
KiCad/trinity/gen/__pycache__/
KiCad/trinity/gen/test/
KiCad/trinity/gen/before/
KiCad/trinity/gen/mixer.kicad_pro
KiCad/trinity/gen/mixer.kicad_prl
cpld/syn/db/
cpld/syn/incremental_db/
cpld/syn/*.rpt
cpld/syn/*.summary
cpld/syn/*.smsg
cpld/syn/*.done
cpld/syn/*.jdi
cpld/syn/*.pin
cpld/syn/*.pof
cpld/syn/*.svf
cpld/syn/*.qws
firmware/rp-gs/build_a/
firmware/rp-gs/build_st/

# сборки RP-AY под плату и самотест; самотест в bin не храним
firmware/rp-ay/build_a/
firmware/rp-ay/build_st/
firmware/rp-ay/bin/rp_ay_st_*.uf2
