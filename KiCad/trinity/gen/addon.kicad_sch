	(text "-5VA: V- of the mixer op-amp U3 (pin 4); 100n near that pin.\n+5VA_1 / +5VA_2: own filter per YM (pin 21 YM2203, pin 1 YM3014B).\nNo 5 V LDO from the 5 V bus - filters only."
		(exclude_from_sim no)
		(at 151.13 151.13 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "561d4bd2-c763-5f2f-9f71-acb75fec7e99")
	)
	(text "NAR1/NAR2 -> right summer (A1, A2), NAR3/NAR4 -> left (C1, C2):\nMIXER inputs ex MIDI / SAA, 10u + 82k. Width: 100k ~25%, 82k ~30%, 68k ~35%."
		(exclude_from_sim no)
		(at 60.96 58.42 0)
		(effects
