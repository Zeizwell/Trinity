		(uuid "561d4bd2-c763-5f2f-9f71-acb75fec7e99")
	)
	(text "NAR1/NAR2 -> right summer (A1, A2), NAR3/NAR4 -> left (C1, C2):\nMIXER inputs ex MIDI / SAA, 10u + 82k. Width: 100k ~25%, 82k ~30%, 68k ~35%."
		(exclude_from_sim no)
		(at 35.56 368.3 0)
