	(text "-5VA: V- of the mixer op-amp U3 (pin 4); 100n near that pin.\n+5VA_1 / +5VA_2: own filter per YM (pin 21 YM2203, pin 1 YM3014B).\nL101-L103 27u shielded 6x6 (SRN6045TA-270M class), DCR <= 0.2 Ohm, >= 0.5 A (LC as NeoGS).\nJP101 1-2 (default): +5V bus; 2-3: +12V -> U105 78M08 -> U104 78M05 (DNP, as MultiSound Max) - only if the bus has +12V."
		(exclude_from_sim no)
		(at 125.73 461.01 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "561d4bd2-c763-5f2f-9f71-acb75fec7e99")
	)
	(text "NAR1/NAR2 -> right summer (A1, A2), NAR3/NAR4 -> left (C1, C2):\nMIXER inputs ex MIDI / SAA, 10u + 82k. Width: 100k ~25%, 82k ~30%, 68k ~35%."
		(exclude_from_sim no)
		(at 35.56 368.3 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "636bd337-ad49-5794-942f-ead503e0cbe1")
	)
	(text "ANALOG POWER (+5V bus via LC; option: +12V -> 78M08 -> 78M05, JP101 2-3)"
		(exclude_from_sim no)
		(at 118.613 334.52 0)
		(effects
			(font
				(size 2.0066 2.0066)
			)
			(justify left bottom)
		)
		(uuid "a043fcfe-4dd6-5055-9371-3413f23f599a")
	)
	(text "NARROW STEREO (DIP ON = narrow ~30%, OFF = plain ABC)"
		(exclude_from_sim no)
		(at 30.48 334.33 0)
		(effects
			(font
				(size 2.0066 2.0066)
			)
			(justify left bottom)
		)
		(uuid "c02eff66-e87c-5e7f-83e4-71d5b7692376")
	)
